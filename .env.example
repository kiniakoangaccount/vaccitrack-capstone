NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side only — bypasses RLS. Required for the admin panel.
# Get this from Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Administrator portal credentials (server-side only — never exposed to the client)
# The portal's URL is intentionally not documented anywhere in this repo — it lives
# only in src/middleware.ts and src/app/<that-path>/. Do not add it to any commit,
# doc, or issue; treat it like a secret. Ask an existing admin for it directly.
# Change these before deploying to production.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Daily vaccination reminder job (server-side only)
CRON_SECRET=replace-with-a-long-random-secret
SEMAPHORE_API_KEY=your-semaphore-api-key
# Optional — must be a sender name registered with Semaphore.
SEMAPHORE_SENDER_NAME=your-registered-sender-name
